# Keep the build context small and secrets out of the image.
.git/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# Never ship data, models or secrets in an image layer.
data/raw/
data/processed/
models/
.env
.env.*
!.env.example

docs/
tests/
*.md
!README.md
