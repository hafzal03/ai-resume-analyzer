# Copy this file to `.env` and adjust for your machine.
# `.env` is git-ignored and must never contain production secrets.
#
# Every setting is prefixed with RC_. Unknown RC_* variables are rejected at
# startup, so a typo fails loudly instead of silently using a default.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# One of: development | testing | production
RC_ENVIRONMENT=development

# Must be false when RC_ENVIRONMENT=production. Enforced at startup: Flask's
# debug mode exposes an interactive console that is a remote code execution
# vector, so the process refuses to start rather than ship it by accident.
RC_DEBUG=false

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
RC_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
RC_HOST=127.0.0.1
RC_PORT=5000

# ---------------------------------------------------------------------------
# Paths (optional -- defaults are relative to the project root)
# ---------------------------------------------------------------------------
# RC_DATA_DIR=/absolute/path/to/data
# RC_MODELS_DIR=/absolute/path/to/models

# ---------------------------------------------------------------------------
# Dataset build
# ---------------------------------------------------------------------------
RC_DATASET_VERSION=v1
RC_RANDOM_SEED=42
RC_SPLIT_TRAIN=0.70
RC_SPLIT_VALIDATION=0.15
RC_SPLIT_TEST=0.15

# Documents shorter than either limit are quarantined, not classified.
RC_MIN_RESUME_CHARS=200
RC_MIN_RESUME_WORDS=30

# Cosine similarity at or above which two resumes count as near duplicates.
RC_NEAR_DUPLICATE_THRESHOLD=0.95

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------
# Leave unset to use the newest trained model in RC_MODELS_DIR.
# RC_MODEL_VERSION=v1

RC_MAX_UPLOAD_BYTES=10485760
RC_MAX_PDF_PAGES=40

# ---------------------------------------------------------------------------
# Database (entirely optional)
# ---------------------------------------------------------------------------
# Persistence is enabled only when a URL is set. Without one the application
# still classifies normally -- it simply records nothing.
# RC_DATABASE_URL=postgresql+psycopg://resume:CHANGE_ME@localhost:5432/resume_db
RC_DATABASE_ECHO=false

# PRIVACY: leave false. When false, only a SHA-256 of the document is stored,
# never the resume text itself. Resumes contain names, addresses, telephone
# numbers and employment history.
RC_STORE_RESUME_TEXT=false

# ---------------------------------------------------------------------------
# docker compose only -- NOT application settings
# ---------------------------------------------------------------------------
# These are ignored by the application and consumed only by docker-compose.yml.
# Note that none of them uses the RC_ prefix: that namespace belongs to the
# application, which rejects any RC_ key it does not recognise.
POSTGRES_DB=resume_db
POSTGRES_USER=resume
POSTGRES_PASSWORD=change-me-before-running
# Bind address for the published web port. 127.0.0.1 keeps it off the network.
COMPOSE_BIND_HOST=127.0.0.1
